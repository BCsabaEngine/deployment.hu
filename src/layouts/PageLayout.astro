---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData } from '~/navigation';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

const latestPosts = await findLatestPosts({ count: 5 });
const footerLinks = latestPosts.length
  ? [
      {
        title: 'Legutóbbi bejegyzések',
        links: latestPosts.map((post) => ({ text: post.title, href: getPermalink(post.permalink, 'post') })),
      },
      ...footerData.links,
    ]
  : footerData.links;
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header {...headerData} isSticky showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} links={footerLinks} />
  </slot>
</Layout>
