---
import Layout from '~/layouts/PageLayout.astro';
import Contact from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Kapcsolat',
  description: 'Vegye fel velem a kapcsolatot egy 15–30 perces, díjmentes online konzultációra.',
};
---

<Layout metadata={metadata}>
  <Contact
    title="Beszéljünk!"
    subtitle="Vegye fel velem a kapcsolatot, hívjon fel, vagy kérjen egy időpontot egy 15–30 perces, természetesen díjmentes online konzultációra. Ismerjük meg egymást nulladik lépésben — utána hívjon meg egy mélyebb beszélgetésre a cégéhez."
    inputs={[
      { type: 'text', name: 'name', label: 'Név', autocomplete: 'name' },
      { type: 'email', name: 'email', label: 'Email', autocomplete: 'email' },
      {
        type: 'select',
        name: 'reason',
        label: 'Miért keres?',
        options: [
          { value: 'tech-lead', label: 'Tech-Lead bérlés / mentorálás' },
          { value: 'platform', label: 'Platform-építés' },
          { value: 'kerekasztal', label: 'AI kerekasztal' },
          { value: 'ai-megoldas', label: 'AI megoldás kialakítása (lokál/hibrid)' },
          { value: 'egyeb', label: 'Csak egy rövid beszélgetés / egyéb' },
        ],
      },
    ]}
    textarea={{ label: 'Üzenet', name: 'message', placeholder: 'Miben segíthetek?' }}
    button="Küldés"
  />

  <div class="max-w-xl mx-auto px-4 sm:px-6 -mt-4 mb-16">
    <div class="rounded-lg border border-amber-300 bg-amber-50 dark:border-amber-700 dark:bg-amber-950/40 p-4 sm:p-6">
      <p class="text-sm text-amber-900 dark:text-amber-200">
        Folyamatban lévő szerződéseim és lejárt szerződéseim titoktartási klauzulái fényében fenn kell tartanom a jogot,
        hogy a céget jobban megismerve, az egyeztetések állapotában nemet mondhassak a megkeresésre és szerződéskötésre.
      </p>
    </div>

    <div class="mt-8 text-center text-muted dark:text-slate-400">
      <p>
        Email: <a class="hover:text-primary hover:underline" href="mailto:hello@deployment.hu">hello@deployment.hu</a>
      </p>
      <p class="mt-1">Telefon: <em>pontosítandó</em></p>
      <p class="mt-1">Válaszidő: <em>pontosítandó</em></p>
    </div>
  </div>

  <!-- TODO: statikus oldal, nincs backend bekötve — a submit egyelőre nem küld sehova. -->
  <script>
    document.querySelector('main form')?.addEventListener('submit', (event) => {
      event.preventDefault();
    });
  </script>
</Layout>
