---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ContentHeading from '~/components/ui/ContentHeading.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'AI kerekasztal',
  description: 'Nem előadás, hanem kerekasztal — standup-os lazasággal.',
};
---

<Layout metadata={metadata}>
  <Hero image={{ src: '~/assets/images/ai-kerekasztal.jpg', alt: 'AI kerekasztal' }}>
    <Fragment slot="title">AI kerekasztal</Fragment>
    <Fragment slot="subtitle">Nem előadás, hanem kerekasztal — standup-os lazasággal.</Fragment>
  </Hero>

  <Content image={{ src: '~/assets/images/ai-kerekasztal-nincs-szinpad.jpg', alt: 'Nincs színpad, nincs taps' }}>
    <Fragment slot="content">
      <ContentHeading>Nincs színpad, nincs taps</ContentHeading>
      <p>
        Ez nem száraz előadás, és nem is képzés — nincs kivetítő, nincs jegyzetelős hangulat, nincs „kérdés a végén”
        blokk. Kerekasztal-beszélgetés van helyette, amelyre hivatalos minden csoportvezető, aki nap mint nap a
        folyamatokkal dolgozik — és egy döntéshozó is, akinek az a szerepe, hogy <strong
          >validálja és mederben tartsa az elhangzottakat</strong
        >. Mert szoktak lenni álmok: szinte mindenki fel akar ülni az AI-vonatra, csak épp kevesen tudják, merre tart,
        és mi lesz a következő állomás.
      </p>

      <ContentHeading>Saját vonat, nem jegy</ContentHeading>
      <p>
        Mi ismerjük a menetrendet — mert nem jegyet váltunk egy közös vonatra, hanem <strong
          >nektek épül egy saját</strong
        >. Ti döntitek el, mire használjátok a hibrid AI-megoldást, milyen folyamatokat támogattok vele, és mit
        automatizáltok belőle. Ez nem egyszeri esemény, hanem folyamatos munka: az automatizálás lépésről lépésre épül
        be a cég mindennapjaiba, jellemzően negyedévente egy újabb kerekasztallal, ahol átbeszéljük, hova jutottunk, és
        mi jön ezután. Mindehhez nem kell külön csapatot felépítenetek és fenntartanotok — ez az én dolgom marad.
      </p>

      <ContentHeading>Nem termék, hanem megoldás</ContentHeading>
      <p>
        Nincs polcról levehető, egy az egyben letelepíthető termékünk — helyette egyedi megoldás készül, ami mindig
        <strong>a cég szellemi tulajdona marad</strong>, a cég saját infrastruktúráján fut, és kizárólag a cég érdekeit
        szolgálja. Nem egy csillogó, fancy nevű, mindenkinek ugyanazt adó terméket telepítünk le: a saját LLM, a hibrid
        AI és a RAG-adatok szinergiájából egy olyan öntanuló rendszer épül, ami <strong>tényleg rátok van szabva</strong
        >. Az AI kerekasztal pont ennek az első lépése — elköteleződés nélküli beszélgetés arról, mi lehetséges, mi nem
        éri meg, és milyen árazási keretek közt mozoghatunk, mindezt szigorúan szem előtt tartva az adatbiztonságot.
      </p>
    </Fragment>
  </Content>

  <Steps
    title="Negyedéves ritmus"
    items={[
      {
        title: 'Első kerekasztal',
        description: 'Hozzatok 3-4 valódi, mindennapi folyamatot — végigbeszéljük, mi automatizálható és mi nem.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Fokozatos bevezetés',
        description: 'Az automatizálások lépésről lépésre épülnek be a cég életébe.',
        icon: 'tabler:route',
      },
      {
        title: 'Újra leülünk negyedévente',
        description: 'Átbeszéljük, hova jutottunk, és mi legyen a következő állomás.',
        icon: 'tabler:calendar-event',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Kérj egy díjmentes konzultációt', href: getPermalink('/kapcsolat') }]}
  >
    <Fragment slot="title">A garancia</Fragment>
    <Fragment slot="subtitle">
      Minden kerekasztalról legalább 3 folyamattal távoztok úgy, hogy pontosan tudjátok, hogyan oldható meg — és
      legalább 1-ről együtt kimondjuk, ha nem éri meg automatizálni. Hozzatok 3-4 valódi, mindennapi folyamatot — a
      többit onnantól én viszem.
    </Fragment>
  </CallToAction>
</Layout>
