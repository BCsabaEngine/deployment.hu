---
import Layout from '~/layouts/Layout.astro';
import MessageSection from '~/components/widgets/MessageSection.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = {
  title: `404 — Az oldal nem található`,
  description: 'A keresett oldal nem található. Térj vissza a főoldalra.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <MessageSection
    srLabel="Hiba"
    title="404"
    message="Sajnos ez az oldal nem található."
    description="Térj vissza a főoldalra."
    action={{ href: getHomePermalink(), text: 'Vissza a főoldalra' }}
  />
</Layout>
