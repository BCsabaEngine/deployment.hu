---
import Layout from '~/layouts/PageLayout.astro';
import MessageSection from '~/components/widgets/MessageSection.astro';
import { headerData } from '~/navigation';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: `404 – Az oldal nem található`,
  description: 'A keresett oldal nem található. Térj vissza a főoldalra.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <MessageSection
    srLabel="Hiba"
    title="404"
    message="Sajnos ez az oldal nem található."
    description="Lehet, hogy elírtad a címet, vagy az oldal már nem létezik. Innen könnyen visszatalálsz."
    actions={[
      { variant: 'primary', text: 'Vissza a főoldalra', href: getHomePermalink() },
      { text: 'Kapcsolat', href: getPermalink('/kapcsolat') },
    ]}
    linksTitle="Erre kereshettél"
    links={headerData.links}
  />
</Layout>
