---
import '~/assets/styles/manrope-fonts.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

<style is:inline>
  :root {
    --aw-font-sans: 'Manrope Variable';
    --aw-font-serif: 'Manrope Variable';
    --aw-font-heading: 'Manrope Variable';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    --aw-color-surface: rgb(255 255 255);
    --aw-color-border: rgb(229 231 235);
    --aw-color-placeholder: rgb(156 163 175);
    --aw-color-eyebrow: rgb(1 84 207);
    --aw-color-link: rgb(1 97 239);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Manrope Variable';
    --aw-font-serif: 'Manrope Variable';
    --aw-font-heading: 'Manrope Variable';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    --aw-color-surface: rgb(15 23 42);
    --aw-color-border: rgb(51 65 85);
    --aw-color-placeholder: rgb(51 65 85);
    --aw-color-eyebrow: rgb(191 219 254);
    --aw-color-link: rgb(147 197 253);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
