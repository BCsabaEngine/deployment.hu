---
import { COMPANY, SITE } from '~/config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  tagline: string;
  pageLinks: Array<Link>;
  secondaryLinks: Array<Link>;
  theme?: string;
}

const { tagline, pageLinks = [], secondaryLinks = [], theme = 'light' } = Astro.props;
---

<footer
  class:list={[
    { dark: theme === 'dark' },
    'relative border-t border-gray-200 dark:border-slate-800 not-prose bg-gray-100',
  ]}
>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 md:col-span-4">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl" href={getHomePermalink()}>{SITE?.name}</a>
        </div>
        <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">{tagline}</p>
      </div>
      <div class="col-span-12 md:col-span-4">
        <div class="dark:text-gray-300 font-medium mb-2">Információk</div>
        <ul class="text-sm text-muted dark:text-slate-400 space-y-1">
          <li>{COMPANY.name}</li>
          <li>
            Email:
            <a
              class="hover:text-gray-700 dark:hover:text-gray-300 hover:underline transition duration-150 ease-in-out"
              href={`mailto:${COMPANY.email}`}
            >
              {COMPANY.email}
            </a>
          </li>
          <li>
            Telefon:
            <a
              class="hover:text-gray-700 dark:hover:text-gray-300 hover:underline transition duration-150 ease-in-out"
              href={`tel:${COMPANY.phone.replace(/\s+/g, '')}`}
            >
              {COMPANY.phone}
            </a>
          </li>
          <li>Cím: {COMPANY.address}</li>
          <li>Adószám: {COMPANY.taxNumber}</li>
        </ul>
        <ul class="text-sm text-muted dark:text-slate-400 space-y-1 mt-4">
          {
            secondaryLinks.map(({ text, href }) => (
              <li>
                <a
                  class="hover:text-gray-700 dark:hover:text-gray-300 hover:underline transition duration-150 ease-in-out"
                  href={href}
                  set:html={text}
                />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="col-span-12 md:col-span-4">
        <div class="dark:text-gray-300 font-medium mb-2">Oldalak</div>
        <ul class="text-sm space-y-1">
          {
            pageLinks.map(({ text, href }) => (
              <li>
                <a
                  class="text-muted hover:text-gray-700 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href={href}
                >
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="py-6 md:py-8 text-sm text-center text-muted dark:text-slate-500">
      © {new Date().getFullYear()} deployment.hu
    </div>
  </div>
</footer>
