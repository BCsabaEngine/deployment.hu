---
import Item from '~/components/blog/GridItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<div
  class:list={['grid gap-6 row-gap-5 md:grid-cols-2 -mb-6', posts.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}
>
  {posts.map((post) => (
    <Item post={post} />
  ))}
</div>
