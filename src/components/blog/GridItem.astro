---
import { APP_BLOG } from '~/config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { REVEAL } from '~/utils/classes';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const ImageWrapper = link ? 'a' : Fragment;
const wrapperProps = link ? { href: link } : {};
---

<article class={`mb-6 transition ${REVEAL}`}>
  <div class="relative md:h-64 img-placeholder rounded shadow-lg mb-6">
    {image && (
      <ImageWrapper {...wrapperProps}>
        <Image
          src={image}
          class="w-full md:h-full object-cover rounded shadow-lg img-placeholder"
          widths={[400, 900]}
          width={900}
          height={506}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post.title}
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </ImageWrapper>
    )}
  </div>

  <h3 class="card-title">
    {link ? (
      <a class="card-link" href={link}>
        {post.title}
      </a>
    ) : (
      post.title
    )}
  </h3>

  <p class="text-muted dark:text-slate-400 text-lg">{post.excerpt}</p>
</article>
