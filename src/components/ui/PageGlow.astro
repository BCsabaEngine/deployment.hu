  <div class="absolute inset-0 bg-[radial-gradient(rgb(100_116_139/0.28)_1px,transparent_1px)] [background-size:24px_24px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)] [-webkit-mask-image:linear-gradient(to_bottom,black,transparent_85%)] dark:bg-[radial-gradient(rgb(148_163_184/0.2)_1px,transparent_1px)]"></div>
